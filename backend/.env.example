# Network / contract
CONTRACT_NETWORK_NAME=localhost
CERTIFICATE_REGISTRY_ADDRESS=
RPC_URL=http://127.0.0.1:8545
SEPOLIA_RPC_URL=

# Server
PORT=5050
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public verify base used for QR URL generation in /api/pin.
# Set this in production, e.g. https://verify.yourdomain.com/verify
PUBLIC_VERIFY_BASE_URL=
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=1mb
MAX_UPLOAD_BYTES=10485760

# Auth / issuer
JWT_SECRET=replace-with-strong-random-secret
JWT_ACCESS_SECRET=replace-with-strong-random-secret
JWT_REFRESH_SECRET=replace-with-different-strong-random-secret
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800
JWT_EXPIRES_IN=1h
AUTH_NONCE_TTL_MS=300000
AUTH_DOMAIN=localhost
AUTH_URI=http://localhost:5050
AUTH_CHAIN_ID=31337
AUTH_RATE_WINDOW_MS=60000
AUTH_RATE_MAX=40
MOE_BOOTSTRAP_SECRET=replace-with-once-secret
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@yourdomain.com
INVITE_EMAIL_SUBJECT_PREFIX=CertChain
ISSUER_PRIVATE_KEY=

# Optional relay mode (default is disabled)
ENABLE_RELAY_TX_MODE=false

# Pinata / IPFS
PINATA_JWT=
IPFS_GATEWAYS=https://ipfs.io,https://gateway.pinata.cloud,https://cloudflare-ipfs.com
IPFS_FETCH_TIMEOUT_MS=8000
IPFS_RETRIES_PER_GATEWAY=1
IPFS_CACHE_TTL_MS=600000
IPFS_CACHE_MAX_ENTRIES=500

# Rate limits
RATE_LIMIT_PIN_WINDOW_MS=60000
RATE_LIMIT_PIN_MAX=10
RATE_LIMIT_VERIFY_WINDOW_MS=60000
RATE_LIMIT_VERIFY_MAX=60

# Indexer
CERT_INDEX_REFRESH_MS=15000
CERT_INDEX_START_BLOCK=0
CERT_INDEX_BLOCK_BATCH_SIZE=2000
CERT_INDEX_POLL_MS=15000
CERT_INDEX_REQUEST_DELAY_MS=250
ISSUER_INDEX_REFRESH_MS=15000
ISSUER_INDEX_START_BLOCK=0
ISSUER_INDEX_POLL_MS=15000

# Optional Supabase indexer
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional verification
ETHERSCAN_API_KEY=
