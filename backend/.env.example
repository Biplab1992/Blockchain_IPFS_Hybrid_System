# Network / contract
CONTRACT_NETWORK_NAME=localhost
CERTIFICATE_REGISTRY_ADDRESS=
RPC_URL=http://127.0.0.1:8545
SEPOLIA_RPC_URL=

# Server
PORT=5050
NODE_ENV=development
# In production, set this to the exact frontend origin(s), comma-separated.
# Example: CORS_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public verify base used for QR URL generation in /api/pin.
# Set this in production, e.g. https://verify.yourdomain.com/verify
PUBLIC_VERIFY_BASE_URL=
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=1mb
MAX_UPLOAD_BYTES=10485760

# Auth / issuer
JWT_SECRET=replace-with-strong-random-secret
JWT_ACCESS_SECRET=replace-with-strong-random-secret
JWT_REFRESH_SECRET=replace-with-different-strong-random-secret
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800
JWT_EXPIRES_IN=1h
AUTH_NONCE_TTL_MS=300000
AUTH_DOMAIN=localhost
AUTH_URI=http://localhost:5050
AUTH_CHAIN_ID=31337
AUTH_RATE_WINDOW_MS=60000
AUTH_RATE_MAX=40
AUTH_LOGIN_TRACK_WINDOW_MS=1800000
AUTH_LOGIN_DELAY_START_AFTER=2
AUTH_LOGIN_DELAY_BASE_MS=250
AUTH_LOGIN_DELAY_MAX_MS=5000
AUTH_LOGIN_LOCKOUT_THRESHOLD=8
AUTH_LOGIN_LOCKOUT_MS=900000
AUTH_REFRESH_COOKIE_NAME=tmc_refresh
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_DOMAIN=
MOE_BOOTSTRAP_SECRET=replace-with-once-secret
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@yourdomain.com
INVITE_EMAIL_SUBJECT_PREFIX=CertChain
EMAIL_SEND_QUEUE_MAX_ATTEMPTS=6
EMAIL_SEND_QUEUE_BASE_DELAY_MS=1000
EMAIL_SEND_QUEUE_MAX_DELAY_MS=60000
EMAIL_SEND_QUEUE_TICK_MS=2000
PASSWORD_RESET_TTL_MS=1800000
# Optional override for reset link in forgot-password emails.
# Example: https://app.yourdomain.com/reset-password
PASSWORD_RESET_URL_BASE=
ISSUER_PRIVATE_KEY=

# Optional relay mode (default is disabled)
ENABLE_RELAY_TX_MODE=false
RELAY_IDEMPOTENCY_TTL_MS=86400000
INDEXER_WRITE_QUEUE_MAX_ATTEMPTS=6
INDEXER_WRITE_QUEUE_BASE_DELAY_MS=1000
INDEXER_WRITE_QUEUE_MAX_DELAY_MS=60000
HEALTH_RPC_TIMEOUT_MS=4000
HEALTH_DB_TIMEOUT_MS=4000
HEALTH_IPFS_TIMEOUT_MS=5000
HEALTH_INDEXER_LAG_WARN_BLOCKS=64

# Pinata / IPFS
PINATA_JWT=
# Required for encrypting certificate files before pinning.
# Use a 32-byte hex string or base64 value.
# Example local-dev key only. Replace in real deployments.
FILE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
FILE_ENCRYPTION_KEY_ID=default
# Optional demo-only override. Listed cert IDs will verify as tampered without changing
# on-chain or IPFS data. Comma-separated.
DEMO_TAMPER_CERT_IDS=
IPFS_GATEWAYS=https://ipfs.filebase.io,https://gateway.pinata.cloud,https://dweb.link
IPFS_FETCH_TIMEOUT_MS=15000
IPFS_RETRIES_PER_GATEWAY=1
IPFS_CACHE_TTL_MS=600000
IPFS_CACHE_MAX_ENTRIES=500

# Rate limits
RATE_LIMIT_PIN_WINDOW_MS=60000
RATE_LIMIT_PIN_MAX=10
RATE_LIMIT_VERIFY_WINDOW_MS=60000
RATE_LIMIT_VERIFY_MAX=60

# Indexer
CERT_INDEX_REFRESH_MS=15000
CERT_INDEX_START_BLOCK=0
CERT_INDEX_BLOCK_BATCH_SIZE=2000
CERT_INDEX_POLL_MS=15000
CERT_INDEX_REQUEST_DELAY_MS=250
ISSUER_INDEX_REFRESH_MS=15000
ISSUER_INDEX_START_BLOCK=0
ISSUER_INDEX_POLL_MS=15000

# Supabase
# Optional if you only want local public pin/verify without auth/RBAC flows.
# Required for auth, MoE/institution admin, invitations, password reset, audit logs,
# and persistent database-backed issuer/admin state.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: limit rows per backfill run (request body `limit` can also be used)
# CERT_METADATA_BACKFILL_LIMIT=500

# Optional verification
ETHERSCAN_API_KEY=
