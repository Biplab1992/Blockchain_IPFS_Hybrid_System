# Used by deploy/test scripts and hardhat config
# Only needed when a script explicitly requires one of these values.
DEPLOYER_PRIVATE_KEY=
ISSUER_ADDRESS=
ALLOWED=true

# Optional network settings (hardhat.config.ts also reads backend/.env)
# Use SEPOLIA_RPC_URL or RPC_URL for remote deploy/verify flows.
RPC_URL=
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# Optional ad-hoc script inputs
CERTIFICATE_REGISTRY_ADDRESS=
ISSUER_PRIVATE_KEY=
